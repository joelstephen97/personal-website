{
  "name": "joelstephen-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm tokens && next build",
    "start": "next start",
    "tokens": "tsx scripts/build-tokens.ts",
    "content-collections": "tsx scripts/build-content-collections.ts",
    "pretypecheck": "pnpm content-collections",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm content-collections",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "measure": "tsx scripts/measure-client-js.ts",
    "resume:pdf": "tsx scripts/build-resume-pdf.ts"
  },
  "dependencies": {
    "@content-collections/core": "^0.15.2",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.42.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
